# MongoDB Atlas connection string. Required - the server refuses to start
# without it. Points at the same cluster as the TypeScript backend; the
# database name ("boring-db") is fixed in code.
BORED_MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net

# Shared secret for the /cron/cleanup endpoints. When unset those routes reject
# every request with CRON_NOT_CONFIGURED. The in-process sweep runs regardless.
CRON_SECRET=

# Extra allowed CORS origins, comma-separated. These are added to the baseline
# list (camkerber.dev, localhost:5173, 127.0.0.1:5173, and *.vercel.app).
CORS_ORIGINS=

# HTTP port. Defaults to 3000.
PORT=3000

# How often the in-process sweep deletes expired sessions and boards.
CLEANUP_INTERVAL=1h

# Optional: a scratch database for integration tests. When unset those tests
# skip, so a clean checkout still passes.
TEST_MONGODB_URI=

# Note: SPOTIFY_CLIENT_ID is NOT needed. The TypeScript version only set it to
# satisfy the Spotify SDK constructor; this service forwards the caller's own
# access token and never identifies itself as a client.
